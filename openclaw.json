{
  "gateway": {
    "mode": "local",
    "controlUi": {
      "allowedOrigins": ["${OPENCLAW_ALLOWED_ORIGINS}"]
    },
    "http": {
      "endpoints": {
        "chatCompletions": { "enabled": true }
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "baseUrl": "${LITELLM_BASE_URL}",
        "apiKey": "${LITELLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "${LITELLM_MODEL}",
            "name": "${LITELLM_MODEL}",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": { "primary": "litellm/${LITELLM_MODEL}" }
    }
  }
}
