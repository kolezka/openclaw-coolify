# Copy to .env locally, or set these as the app's environment variables in Coolify.
# Never commit a real .env file — this repo is public.

# Pin the image to a specific release. Check https://github.com/openclaw/openclaw/releases
# for the current tag before deploying; don't run :latest in production.
OPENCLAW_VERSION=2026.2.26

# Required. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Required. The public URL Coolify assigns this app (set after first deploy,
# then redeploy) — enables CORS for the Control UI/dashboard.
OPENCLAW_ALLOWED_ORIGINS=

# --- LiteLLM integration ---
# The official openclaw image has no env-driven model config: these two values
# are NOT read automatically by the container. They exist so you have them
# on hand when you configure the provider by hand (see README step 5).
LITELLM_BASE_URL=
LITELLM_API_KEY=

# --- Optional: Telegram channel ---
# Only needed if you enable the Telegram channel during `openclaw configure`.
TELEGRAM_BOT_TOKEN=
