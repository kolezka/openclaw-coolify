# Set these in Coolify. Never commit a real .env; this repo is public.
# Keep this aligned with the tested Desktop/CUA version in the Dockerfile.
OPENCLAW_VERSION=2026.10.1

# Runtime-only secret in Coolify, never a build variable. Exactly 8 printable ASCII bytes.
DESKTOP_VNC_PASSWORD=
# Keep loopback until LAN/firewall checks pass; then set the host's private IPv4 address.
DESKTOP_VNC_BIND_ADDRESS=127.0.0.1
DESKTOP_VNC_PORT=5901

# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# The dashboard's origin, scheme + host, no path. Set it before the first deploy.
OPENCLAW_ALLOWED_ORIGINS=https://openclaw.example.com

# LiteLLM proxy, including /v1. Use a virtual key, not a provider key.
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=

# Must match your LiteLLM alias AND a model declaration in openclaw.json.
# For another alias, define its limits and compatibility before first boot.
LITELLM_MODEL=deepseek/deepseek-v4-pro

# Optional: only required when docker-compose.brain.yml is enabled.
# Absolute path on the Docker host, not on a remote developer laptop.
# The checkout must already exist and be writable by the container user.
# OPENCLAW_BRAIN_PATH=/srv/openclaw-brain
