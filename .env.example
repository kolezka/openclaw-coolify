# Set these in Coolify. Never commit a real .env; this repo is public.
OPENCLAW_VERSION=2026.2.26

# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# The dashboard's origin, scheme + host, no path. Set it before the first deploy.
OPENCLAW_ALLOWED_ORIGINS=https://openclaw.example.com

# LiteLLM proxy, including /v1. Use a virtual key, not a provider key.
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=

# model_name alias from your LiteLLM model_list
LITELLM_MODEL=my-litellm-alias
